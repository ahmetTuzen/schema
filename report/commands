# citeseer clustering
python clustering/main.py --dataset citeseer --propagation_alpha 0.9 --branching_cap 32


# citeseer generation
# Consider suppressing warnings in edge training for this dataset by python generation/main.py ... 2> >(grep -v 'IntraEdge negative sampling undersampled')
python generation/main.py --dataset citeseer \
	--json-path ./output/clusters/citeseer/cluster_mapping.json --out-dir ./output/generation/citeseer \
	--latent-dim 32 --dropout 0.25 --num-layers 4 --gen-chunk-size 128 \
	--num-epochs 500 --inter-gen-cluster-threshold 0.1 --inter-budget-scale 4.0 


